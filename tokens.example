# Copy to `secrets/tokens` and fill in real values. Never commit secrets.
#
# Key names are free-form, but whatever you use here must be typed into the
# UI's token field exactly. See "Token setup" in README.md for full details.
#
#   GitHub  — classic PAT, scopes: repo, read:org
#   GitLab  — classic PAT, scopes: read_api AND read_repository,
#             role Reporter or higher. Fine-grained GitLab tokens do NOT work:
#             they return 200 with an empty project list instead of an error.
#   Bitbucket Cloud — Atlassian scoped API token (ATAT...) with scopes
#             read:repository:bitbucket and read:pullrequest:bitbucket, plus the
#             Atlassian account email for REST Basic auth. Omit bitbucket_email
#             for workspace/repository access tokens (sent as Bearer). git
#             cloning always uses the x-token-auth username automatically.
#             There is no account-wide discovery: a workspace slug is required.
#   OpenAI  — only needed for --llm mode

github-data-token=ghp_your_github_token_here
gitlab_token=glpat_your_gitlab_token_here
bitbucket_token=ATATT_your_bitbucket_token_here
bitbucket_email=you@example.com
openai_key=sk-your_openai_key_here

# Optional — GitHub App auth for extract_org_raw_data.py --github-app
# Defaults in code: app id 4284468 + data-labs-codebase-analysis.2026-07-12.private-key.pem
# github_app_id=4284468
# github_app_pem=data-labs-codebase-analysis.2026-07-12.private-key.pem

# Optional — GitLab OAuth application
# gitlab_oauth_client_id=your_application_id
# gitlab_oauth_client_secret=gloas-your_secret
# gitlab_oauth_redirect_uri=http://localhost:8765/callback
# gitlab_oauth_scopes=read_api read_repository

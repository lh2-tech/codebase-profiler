# Copy to .env and adjust as needed.

# Host port for the browser UI
UI_PORT=8766

# Host folder containing full local git clones for offline mode.
# Inside the UI, use the container path /data/repos (not this host path).
LOCAL_REPOS_DIR=./repos

# Host folder containing full local Mercurial clones (folders with .hg) for the
# "Mercurial (local)" UI mode. Container path: /data/hg-repos.
LOCAL_HG_REPOS_DIR=./hg-repos

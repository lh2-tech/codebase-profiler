# Copy to .env and adjust as needed.

# Host port for the browser UI
UI_PORT=8766

# Host folder containing full local git clones for offline mode.
# Inside the UI, use the container path /data/repos (not this host path).
LOCAL_REPOS_DIR=./repos

# Host folder containing full local Mercurial clones (folders with .hg) for the
# "Mercurial (local)" UI mode. Container path: /data/hg-repos.
LOCAL_HG_REPOS_DIR=./hg-repos

# Folder of already-synced Perforce workspaces for the "Perforce (server)" tab's "use workspaces I already have"
# option (skips the download). Container path: /data/p4-workspaces.
LOCAL_P4_WORKSPACES_DIR=./p4-workspaces

# Repos whose duplicate_pct (share of their commits that also exist in another repo of the run) is ABOVE this
# percentage are flagged: duplicate_of / duplicate_loc / duplicate_prs are filled and they are highlighted in
# summary.xlsx and project_compiled.xlsx. Default 25.
DUPLICATE_THRESHOLD_PCT=25
